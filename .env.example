# ═════════════════════════════════════════════
# Multipu - Environment Configuration Template
# ═════════════════════════════════════════════

# Session Security (Generate a random 32+ character string)
SESSION_SECRET=your-secure-session-secret-at-least-32-chars-long

# Solana Configuration
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_APP_PHASE=testnet
NEXT_PUBLIC_ENABLE_MAINNET_LAUNCHES=false
ENABLE_MAINNET_LAUNCHES=false

# EVM / BSC Configuration
ENABLE_EVM_LAUNCH_ADAPTERS=false
NEXT_PUBLIC_ENABLE_EVM_LAUNCH_ADAPTERS=false
BSC_RPC_URL=https://bsc-dataseed.binance.org

# Supabase (Database & State)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Admin Panel & Security
ADMIN_WALLETS=
ADMIN_PANEL_PASSWORD=your-admin-password
ADMIN_IP_WHITELIST=127.0.0.1,::1
ADMIN_SESSION_TIMEOUT_MINUTES=480

# Treasury & Fee Collection (Privy Server Wallets)
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret

# Solana Treasury (Meteora, Bags, Pump.fun)
PRIVY_SOLANA_WALLET_ID=your-privy-solana-wallet-id
TREASURY_SOLANA_WALLET_ADDRESS=your-solana-treasury-public-address

# BNB Chain Treasury (Four.meme)
PRIVY_BSC_WALLET_ID=your-privy-bsc-wallet-id
TREASURY_BSC_WALLET_ADDRESS=your-bsc-treasury-public-address

# Treasury Limits
TREASURY_TRANSFER_LOCK_MINUTES=60
TREASURY_MAX_TRANSFER_SOL=1000
TREASURY_MAX_TRANSFER_BNB=500
